---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import { Image } from "astro:assets";
import { areas } from "../../../data/areas";

export function getStaticPaths() {
    return areas.map((area) => ({
        params: { slug: area.slug },
        props: { area },
    }));
}

const { area } = Astro.props;
const lang = "en";
const t = area.t[lang];
const alternates = {
    ar: `/ar/areas/${area.slug}/`,
    fr: `/fr/areas/${area.slug}/`,
    en: `/en/areas/${area.slug}/`,
};
---

<BaseLayout
    title={`${t.title} — ASA`}
    description={t.tagline}
    {lang}
    alternates={alternates}
>
    <Breadcrumb
        items={[
            { label: "Home", href: "/en/" },
            { label: "Areas", href: "/en/areas/" },
            { label: t.title },
        ]}
    />

    <article class="section-tight stack-26">
        <div class="stack-18">
            <div class="pill">
                <Image src={area.icon} alt={t.title} width={28} height={28} />
                <span>{t.title}</span>
            </div>

            <div>
                <h2>{t.title}</h2>
                <p class="muted">{t.tagline}</p>
            </div>

            <p>{t.description}</p>
        </div>

        <div class="card stack-18">
            <h3>What You'll Learn</h3>
            <ul>
                {t.topics.map((topic) => <li>{topic}</li>)}
            </ul>
        </div>

        <div class="btns">
            <a class="btn primary" href="/en/workshops/">Browse Workshops</a>
            <a class="btn" href="/en/areas/">← All Areas</a>
        </div>
    </article>
</BaseLayout>
