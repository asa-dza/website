---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getLocalizedAreas } from "../../../data/areas";
import { Image } from "astro:assets";

const lang = "fr";
const alternates = { ar: "/ar/areas/", fr: "/fr/areas/", en: "/en/areas/" };
const areas = getLocalizedAreas(lang);
---

<BaseLayout title="Domaines — ASA" {lang} alternates={alternates}>
    <section class="section-tight">
        <div>
            <h2>Nos domaines d'intervention</h2>
            <p class="muted">
                Explorez les domaines dans lesquels notre académie est
                spécialisée.
            </p>
        </div>

        <div class="areas-grid">
            {
                areas.map((area) => (
                    <a href={`/fr/areas/${area.slug}/`} class="area-card">
                        <div class="icon">
                            <Image
                                src={area.icon}
                                alt={area.title}
                                width={100}
                                height={100}
                            />
                        </div>
                        <h2>{area.title}</h2>
                        <p class="muted">{area.tagline}</p>
                        <ul class="topics">
                            {area.topics.map((topic) => (
                                <li>{topic}</li>
                            ))}
                        </ul>
                        <span class="cta">En savoir plus →</span>
                    </a>
                ))
            }
        </div>
    </section>
</BaseLayout>
