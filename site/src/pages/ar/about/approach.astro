---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { siteFullName, siteDescription } from "../../../i18n/site.ts";
import Breadcrumb from "../../../components/Breadcrumb.astro";

const lang = "ar";
const alternates = {
    ar: "/ar/about/approach/",
    fr: "/fr/about/approach/",
    en: "/en/about/approach/",
};
---

<BaseLayout
    title={siteFullName[lang]}
    description={siteDescription[lang]}
    lang={lang}
    alternates={alternates}
>
    <Breadcrumb
        items={[
            { label: "الرئيسية", href: "/ar/" },
            { label: "عن ASA", href: "/ar/about/" },
            { label: "المقاربة التعليمية" },
        ]}
    />

    <!-- Page intro -->
    <section class="hero section-tight">
        <div class="stack-18">
            <h1>المقاربة التعليمية</h1>

            <p>
                تطوّر ASA تجارب تعلم مصممة للاستجابة للاحتياجات المتغيرة للبيئات
                المهنية الحديثة. تُولي مقاربتنا أهمية قصوى للبنية الواضحة، ووضوح
                الأهداف، والتوافق المحكم بين أنشطة التعلم والكفاءات الميدانية.
            </p>

            <p class="muted">
                تُصمَّم الورشات لتقديم تجارب تعلم مركّزة تجمع بين الصرامة
                الأكاديمية، التطبيق العملي، والدعم التكنولوجي الحديث.
            </p>
        </div>
    </section>

    <!-- Structured learning -->
    <section class="section">
        <div class="card">
            <div class="stack-18">
                <div>
                    <h3>تصميم تعلم منظم</h3>
                    <p class="muted" style="margin:0;">
                        أهداف واضحة وتقدم منطقي
                    </p>
                </div>

                <p>
                    تعتمد كثير من مبادرات التطوير على جلسات مفككة تنصبّ أساساً
                    على نقل المعلومات. في المقابل، تُبنى ورشات ASA كوحدات تعلم
                    منظمة، مرتكزة على أهداف محددة بوضوح وتقدم منطقي متسلسل.
                </p>

                <p>
                    يسعى كل ورشة إلى قيادة المشاركين عبر تسلسل متماسك من
                    المفاهيم والعروض التوضيحية والأنشطة التطبيقية التي تدعم
                    تنمية كفاءات حقيقية ودائمة.
                </p>
            </div>
        </div>
    </section>

    <!-- Targeted learning -->
    <section class="section">
        <div class="card">
            <div class="stack-18">
                <div>
                    <h3>تحديد دقيق للجمهور المستهدف</h3>
                    <p class="muted" style="margin:0;">
                        برامج مصممة لفئات متعلمين محددة
                    </p>
                </div>

                <p>
                    يستلزم التعلم الفعّال فهماً واضحاً للفئة التي يستهدفها
                    البرنامج. تحدد ورشات ASA جمهورها المقصود بعناية، سواء أكان
                    المشاركون طلاباً، أم مهنيين في بداية مسيرتهم، أم ممارسين ذوي
                    خبرة.
                </p>

                <p>
                    يتيح هذا التوجه المستهدف لكل ورشة التركيز على المعارف
                    والكفاءات الأكثر أهمية لكل فئة.
                </p>
            </div>
        </div>
    </section>

    <!-- Market relevance -->
    <section class="section">
        <div class="card">
            <div class="stack-18">
                <div>
                    <h3>التوافق مع الاحتياجات المهنية</h3>
                    <p class="muted" style="margin:0;">
                        ربط التعلم بمتطلبات الواقع المهني
                    </p>
                </div>

                <p>
                    تحرص ASA على أن تعكس برامجها الواقع المهني الراهن. تُطوَّر
                    الورشات مع مراعاة التحولات القطاعية، والتوجهات التكنولوجية،
                    وحقول الخبرة الناشئة.
                </p>

                <p>
                    بمواءمة أهداف التعلم مع السياقات المهنية الفعلية، تهدف
                    الأكاديمية إلى تزويد المشاركين بكفاءات قابلة للتطبيق مباشرة
                    في البيئتين الأكاديمية والمهنية.
                </p>
            </div>
        </div>
    </section>

    <!-- Technology integration -->
    <section class="section">
        <div class="card">
            <div class="stack-18">
                <div>
                    <h3>تعلم مدعوم بالتكنولوجيا</h3>
                    <p class="muted" style="margin:0;">
                        أدوات حديثة وبيئات رقمية
                    </p>
                </div>

                <p>
                    يعتمد التعلم المعاصر بصورة متزايدة على البنى التحتية الرقمية
                    والأدوات الحاسوبية. تُدعَم ورشات ASA ببيئات تكنولوجية حديثة
                    تتيح التجريب، والتعلم التفاعلي، والوصول إلى موارد متقدمة.
                </p>

                <p>
                    تُولى عناية خاصة لدور الذكاء الاصطناعي والتقنيات الرقمية في
                    تشكيل الممارسات المهنية المستقبلية.
                </p>
            </div>
        </div>
    </section>

    <!-- Focused format -->
    <section class="section">
        <div class="card">
            <div class="stack-18">
                <div>
                    <h3>صيغة الورشة المركّزة</h3>
                    <p class="muted" style="margin:0;">
                        العمق والنتائج القابلة للقياس
                    </p>
                </div>

                <p>
                    تُفضّل ASA صيغ الورشات المكثفة التي تتيح للمتعلمين الانغماس
                    في موضوع ما بعمق خلال إطار زمني محدود وقابل للإدارة. يدعم
                    هذا النموذج تعلماً مركّزاً مع بقائه متوافقاً مع الجداول
                    الزمنية المهنية والأكاديمية المشغولة.
                </p>

                <p>
                    حين يكون ذلك ملائماً، تدمج الورشات تمارين وعروضاً توضيحية
                    وأنشطة قائمة على المشاريع، مصممة لترجمة المعرفة إلى كفاءات
                    ملموسة.
                </p>
            </div>
        </div>
    </section>
</BaseLayout>
