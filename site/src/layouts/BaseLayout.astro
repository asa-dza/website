---
import "../styles/global.css";
import { siteUrl, type Lang } from "../i18n/site.ts";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
    title?: string;
    description?: string;
    lang: "ar" | "fr" | "en";
    alternates: {
        ar: string;
        fr: string;
        en: string;
    };
}

const { title = "ASA", description, lang, alternates } = Astro.props;
const dir = lang === "ar" ? "rtl" : "ltr";
const site = siteUrl;

function abs(path: string) {
    return new URL(path, site).toString();
}
---

<html lang={lang} dir={dir}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>

        {description && <meta name="description" content={description} />}

        <link rel="canonical" href={abs(alternates[lang])} />
        <link rel="alternate" hreflang="ar" href={abs(alternates.ar)} />
        <link rel="alternate" hreflang="fr" href={abs(alternates.fr)} />
        <link rel="alternate" hreflang="en" href={abs(alternates.en)} />
        <link rel="alternate" hreflang="x-default" href={abs(alternates.en)} />

        <meta property="og:title" content={title} />
        {description && <meta property="og:description" content={description} />}
        <meta property="og:type" content="website" />

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&family=Source+Sans+3:wght@400;600;700&display=swap"
            rel="stylesheet"
        />

        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <slot name="head" />
    </head>

    <body>
        <a href="#main-content" class="skip-link">Skip to content</a>
        <Header lang={lang} alternates={alternates} />
        <main id="main-content" class="wrap">
            <slot />
        </main>
        <Footer lang={lang} />
    </body>
</html>