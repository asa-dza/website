---
const { title, url } = Astro.props;
import { Icon } from "astro-icon/components";
---

<!-- Share button.
Usage:
        <div class="share-section">
            <ShareButton title="Title" url={Astro.url.href} />
        </div>
 -->
<div class="share-wrap">
    <button id="share-btn" aria-label="Share">
        <Icon name="lucide:share-2" />
        <span>Share</span>
    </button>
    <span id="share-msg" class="share-msg" aria-live="polite" role="status"
    ></span>
</div>

<script define:vars={{ title, url }}>
    const shareBtn = document.getElementById("share-btn");
    const shareMsg = document.getElementById("share-msg");
    let hideTimer;

    function showMessage(text) {
        shareMsg.textContent = text;
        shareMsg.classList.add("visible");
        clearTimeout(hideTimer);
        hideTimer = setTimeout(() => {
            shareMsg.classList.remove("visible");
        }, 1800);
    }

    shareBtn.addEventListener("click", async () => {
        try {
            if (navigator.share) {
                await navigator.share({ title, url });
            } else {
                await navigator.clipboard.writeText(url);
                showMessage("Link copied");
            }
        } catch (err) {
            if (!navigator.share) {
                showMessage("Could not copy link");
            }
        }
    });
</script>

<style>
    .share-wrap {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
    }

    .share-msg {
        opacity: 0;
        visibility: hidden;
        transform: translateY(-4px);
        transition:
            opacity 0.2s ease,
            transform 0.2s ease,
            visibility 0.2s;
        pointer-events: none;
        font-size: 0.9rem;
        color: var(--SupportingText, #555);
    }

    .share-msg.visible {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
    }

    .share-sidebar {
        position: sticky;
        top: 2rem;
    }

    @media (max-width: 768px) {
        .share-sidebar {
            display: none;
        }
    }
</style>
