# ============================================================
# BUILD OUTPUT
# ============================================================
dist/
.astro/

# ============================================================
# DEPENDENCIES
# ============================================================
node_modules/

# ============================================================
# LOGS
# ============================================================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ============================================================
# ENVIRONMENT VARIABLES
# ============================================================
.env
.env.production

# ============================================================
# IDE / OS FILES
# ============================================================
.DS_Store
.idea/

# ============================================================
# DOCKER
# ============================================================
# Nothing Docker-related is ignored here, deliberately. This block used to list
# `Dockerfile` and `.gitignore`, which meant the image definition was not
# tracked -- a fresh clone could not build the site at all, and the platform
# stack's `website` service would fail on a missing Dockerfile.
#
# Keeping files out of the *build context* is `.dockerignore`'s job, and it
# already excludes both. Keeping them out of version control was a different
# thing wearing the same name.
